{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "ESNext.Disposable", "DOM"],
    "skipLibCheck": true
  },
  "include": ["src/**/*.js", "examples/**/*.js", "tools/corpus/check.js", "tools/corpus/summary.js"]
}
