{
  "name": "ieee1599jslibrary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run schema:check && node --test tests/*.test.js",
    "test:browser": "node --test tests/browser/*.test.js",
    "docs:build": "node tools/docs/build.js",
    "schema:generate": "node tools/schema/generate.js",
    "schema:check": "node tools/schema/generate.js --check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "mediabunny": "1.66.1",
    "marked": "^17.0.1",
    "playwright-core": "^1.57.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "mediabunny": "^1.66.1"
  },
  "peerDependenciesMeta": {
    "mediabunny": {
      "optional": true
    }
  },
  "exports": {
    ".": "./src/index.js",
    "./adapters/mediabunny": "./src/adapters/mediabunny.js",
    "./ui/score-view.js": "./src/ui/score-view.js",
    "./ui/transport-controls.js": "./src/ui/transport-controls.js",
    "./schema/ieee1599.dtd": "./schema/ieee1599.dtd"
  }
