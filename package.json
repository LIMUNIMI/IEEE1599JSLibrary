{
  "name": "ieee1599jslibrary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "serve": "node tools/serve.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run schema:check && node --test tests/*.test.js",
    "test:browser": "node --test tests/browser/*.test.js",
    "test:corpus": "node tools/corpus/run.js",
    "test:artifacts": "pnpm run docs:build && pnpm pack --pack-destination dist && node --test tests/artifacts.test.mjs",
    "test:browser:matrix": "node --test --test-concurrency=2 --test-timeout=45000 tests/browser/capabilities.test.js tests/browser/encoded-media.test.js tests/browser/model.test.js tests/browser/score-ui.test.js tests/browser/streaming.test.js tests/browser/ui.test.js tests/browser/xml.test.js",
    "types:build": "node tools/types/clean.js && tsc --project tsconfig.build.json",
    "types:check": "pnpm run types:build && tsc --project tsconfig.types-test.json",
    "prepack": "pnpm run types:build",
    "docs:build": "node tools/docs/build.js",
    "schema:generate": "node tools/schema/generate.js",
    "schema:check": "node tools/schema/generate.js --check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "mediabunny": "1.66.1",
    "marked": "^17.0.1",
    "playwright-core": "^1.57.0",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "mediabunny": "^1.66.1"
  },
  "peerDependenciesMeta": {
    "mediabunny": {
      "optional": true
    }
  },
  "files": [
    "src/",
    "schema/ieee1599.dtd",
    "dist/types/",
    "docs/",
    "examples/starter/index.html",
    "examples/starter/main.js",
    "examples/embed/index.html",
    "examples/embed/main.js",
    "examples/streaming/index.html",
    "examples/streaming/main.js",
    "schema/README.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./src/index.js"
    },
    "./adapters/mediabunny": {
      "types": "./src/adapters/mediabunny.d.ts",
      "import": "./src/adapters/mediabunny.js"
    },
    "./ui/score-view.js": {
      "types": "./dist/types/ui/score-view.d.ts",
      "import": "./src/ui/score-view.js"
    },
    "./ui/transport-controls.js": {
      "types": "./dist/types/ui/transport-controls.d.ts",
      "import": "./src/ui/transport-controls.js"
    },
    "./ui/score-pager.js": {
      "types": "./dist/types/ui/score-pager.d.ts",
      "import": "./src/ui/score-pager.js"
    },
    "./ui/player-element.js": {
      "types": "./dist/types/ui/player-element.d.ts",
      "import": "./src/ui/player-element.js"
    },
    "./adapters/iiif": {
      "types": "./dist/types/adapters/iiif.d.ts",
      "import": "./src/adapters/iiif.js"
    },
    "./schema/ieee1599.dtd": "./schema/ieee1599.dtd"
  }
}
